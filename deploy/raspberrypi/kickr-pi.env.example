# Optional overrides — copy to /etc/kickr-pi.env and edit.
# Systemd loads this file if present (see kickr-pi.service).

# Bind all interfaces (default). Use 127.0.0.1 for localhost-only.
# KICKR_HOST=0.0.0.0

# UI port. 8080 needs no privileges; 80 works via CAP_NET_BIND_SERVICE.
# KICKR_PORT=8080

# Trainer mode: dircon (real KICKR) or simulated (dev only)
# KICKR_TRAINER_MODE=dircon

# Skip auto-connect on boot if you prefer Settings → Discover later
# KICKR_AUTO_CONNECT=true

# Local Ollama for training-plan sketches (install.sh enables when Ollama is ready)
# KICKR_OLLAMA_ENABLED=false
# KICKR_OLLAMA_BASE_URL=http://127.0.0.1:11434
# KICKR_OLLAMA_MODEL=llama3.1:8b
