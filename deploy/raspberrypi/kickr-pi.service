[Unit]
Description=KICKR Pi Trainer
Documentation=file:///opt/kickr-pi/README.md
After=network-online.target avahi-daemon.service
Wants=network-online.target

[Service]
Type=simple
User=kickr-pi
Group=kickr-pi
WorkingDirectory=/opt/kickr-pi
Environment=KICKR_HOST=0.0.0.0
Environment=KICKR_PORT=8080
Environment=KICKR_TRAINER_MODE=dircon
EnvironmentFile=-/etc/kickr-pi.env
ExecStart=/opt/kickr-pi/.venv/bin/kickr-pi
Restart=on-failure
RestartSec=5
# Allow KICKR_PORT=80 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Logging → journald (journalctl -u kickr-pi -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kickr-pi

[Install]
WantedBy=multi-user.target
