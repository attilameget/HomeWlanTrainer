<?xml version="1.0" encoding="UTF-8"?>
<!--
  Legacy template. The packaged macOS app manages Open at Login itself via
  ~/Library/LaunchAgents/com.steadygrind.trainer.plist (menu-bar agent).
  Do not install this file alongside the app — you would get two agents.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.steadygrind</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPLACE_WITH_REPO/deploy/macos/run.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
