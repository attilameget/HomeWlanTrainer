<?xml version="1.0" encoding="UTF-8"?>
<!-- Optional Phase A launchd agent. Copy to ~/Library/LaunchAgents/ and load with launchctl.
     Prefer ./deploy/macos/run.sh while developing. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kickr-pi</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPLACE_WITH_REPO/deploy/macos/run.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
